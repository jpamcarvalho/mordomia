# Copy to .env.local and fill in.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google Cloud → APIs & Services → Credentials
# Server-only key for Places API (New). Never expose to the browser.
GOOGLE_PLACES_API_KEY=
# Browser key for Maps JavaScript API. Restrict it to your domains (HTTP referrers).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
