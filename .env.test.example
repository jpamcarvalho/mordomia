# Copy to .env.test (git-ignored). Values come from `npx supabase status` (local Supabase).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Used only by e2e helpers (tests/e2e/helpers) to create confirmed users via the admin API.
SUPABASE_SERVICE_ROLE_KEY=
# Not needed by the current e2e tests (they never reach Google).
GOOGLE_PLACES_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY / NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID are not needed: e2e tests block Google Maps.
